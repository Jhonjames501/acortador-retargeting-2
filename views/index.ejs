<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Acortador B2B con Retargeting</title>
    <!-- Tailwind CSS CDN para diseño moderno -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between">

    <!-- Header -->
    <header class="border-b border-slate-800 bg-slate-900/50 backdrop-blur-md py-4 px-6 flex justify-between items-center">
        <h1 class="text-xl font-bold bg-gradient-to-r from-blue-400 to-indigo-500 bg-clip-text text-transparent">
            RetargetingB2B Linker
        </h1>
        <span class="text-xs bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-3 py-1 rounded-full font-medium">
            Sistema en Línea
        </span>
    </header>

    <!-- Main Container -->
    <main class="max-w-3xl mx-auto px-4 py-12 w-full flex-grow flex flex-col justify-center">
        <div class="text-center mb-10">
            <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-3">
                Acorta, rastrea y optimiza tus enlaces
            </h2>
            <p class="text-slate-400 text-sm md:text-base">
                Genera URLs cortas con píxeles de retargeting integrados para tus campañas comerciales.
            </p>
        </div>

        <!-- Card Formulario -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 md:p-8 shadow-2xl">
            <form action="/shorten" method="POST" class="space-y-5">
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
                        URL de Destino (Larga)
                    </label>
                    <input 
                        type="url" 
                        name="originalUrl" 
                        required 
                        placeholder="https://tu-sitio.com/landing-page" 
                        class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-100 focus:outline-none focus:border-blue-500 transition-colors"
                    >
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
                        Alias Personalizado (Opcional)
                    </label>
                    <input 
                        type="text" 
                        name="customAlias" 
                        placeholder="ej. oferta-verano" 
                        class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-100 focus:outline-none focus:border-blue-500 transition-colors"
                    >
                </div>

                <button 
                    type="submit" 
                    class="w-full bg-blue-600 hover:bg-blue-500 text-white font-semibold py-3 px-6 rounded-xl transition-all shadow-lg shadow-blue-600/20"
                >
                    Generar Enlace Acortado
                </button>
            </form>

            <% if (shortUrl) { %>
                <!-- Resultado -->
                <div class="mt-8 pt-6 border-t border-slate-800">
                    <h3 class="text-sm font-semibold text-emerald-400 mb-2">¡Enlace generado con éxito!</h3>
                    <div class="flex items-center justify-between bg-slate-950 border border-slate-800 rounded-xl p-3">
                        <span id="resultLink" class="text-blue-400 truncate text-sm mr-2"><%= shortUrl %></span>
                        <button 
                            onclick="navigator.clipboard.writeText('<%= shortUrl %>'); alert('¡Copiado al portapapeles!');"
                            class="bg-slate-800 hover:bg-slate-700 text-xs font-medium px-3 py-2 rounded-lg transition-colors flex-shrink-0"
                        >
                            Copiar
                        </button>
                    </div>
                </div>
            <% %>
        </div>
    </main>

    <!-- Footer -->
    <footer class="text-center py-6 text-xs text-slate-500 border-t border-slate-900">
        Acortador con Retargeting B2B &bull; Desplegado en Render
    </footer>

</body>
</html>
