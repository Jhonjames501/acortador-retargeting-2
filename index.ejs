<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LinkPulse | B2B Suite</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between font-sans selection:bg-purple-500 selection:text-white">

    <!-- Header -->
    <header class="border-b border-slate-800/80 bg-slate-900/50 backdrop-blur-md sticky top-0 z-50">
        <div class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between">
            <div class="flex items-center space-x-2">
                <span class="bg-gradient-to-tr from-purple-600 to-indigo-500 p-2 rounded-xl text-white shadow-lg shadow-purple-600/30 text-sm">⚡</span>
                <span class="font-bold tracking-tight text-base">LinkPulse <span class="text-xs bg-purple-500/20 text-purple-400 px-2 py-0.5 rounded-full border border-purple-500/30 font-medium">B2B SUITE</span></span>
            </div>
            <div class="text-xs bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-2.5 py-1 rounded-full flex items-center gap-1.5 font-medium">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Estado: Activo
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-4xl mx-auto px-4 py-8 w-full flex-grow">
        
        <!-- Hero Section -->
        <div class="text-center mb-8">
            <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight mb-2 bg-gradient-to-r from-white via-slate-200 to-slate-400 bg-clip-text text-transparent">
                Acortador Inteligente & Retargeting
            </h1>
            <p class="text-slate-400 text-xs md:text-sm max-w-lg mx-auto">
                Crea enlaces corporativos de alto rendimiento, rastrea conversiones y despliega píxeles de retargeting en tiempo real.
            </p>
        </div>

        <!-- Card Form -->
        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 md:p-6 shadow-2xl backdrop-blur-sm mb-8">
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="mb-4 p-3 bg-red-500/10 border border-red-500/30 text-red-400 text-xs rounded-xl">
                    <%= error %>
                </div>
            <% } %>

            <form action="/shorten" method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
                        URL de Destino (Original)
                    </label>
                    <input type="url" name="originalUrl" required 
                           placeholder="https://tuempresa.com/landing-page"
                           value="<%= typeof originalUrl !== 'undefined' && originalUrl ? originalUrl : '' %>"
                           class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-purple-500 transition duration-200">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
                        Alias Personalizado (Opcional)
                    </label>
                    <div class="flex rounded-xl bg-slate-950 border border-slate-800 overflow-hidden focus-within:border-purple-500 transition duration-200">
                        <span class="bg-slate-900 text-slate-500 px-3 py-3 text-xs md:text-sm flex items-center border-r border-slate-800">/</span>
                        <input type="text" name="customAlias" 
                               placeholder="oferta-verano"
                               class="w-full bg-transparent px-3 py-3 text-sm text-white placeholder-slate-600 focus:outline-none">
                    </div>
                </div>

                <button type="submit" 
                        class="w-full bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-medium py-3 px-4 rounded-xl transition duration-200 shadow-lg shadow-purple-600/25 text-sm cursor-pointer">
                    Generar Enlace Acortado
                </button>
            </form>

            <!-- Resultado generado -->
            <% if (typeof shortUrl !== 'undefined' && shortUrl) { %>
                <div class="mt-6 pt-5 border-t border-slate-800/80">
                    <p class="text-xs font-semibold text-emerald-400 uppercase tracking-wider mb-2">¡Enlace generado con éxito!</p>
                    <div class="flex items-center justify-between bg-slate-950 border border-slate-800 rounded-xl p-3 gap-2">
                        <input type="text" readonly value="<%= shortUrl %>" id="shortenedLink" 
                               class="bg-transparent text-xs md:text-sm text-purple-300 w-full focus:outline-none select-all truncate">
                        <button onclick="navigator.clipboard.writeText(document.getElementById('shortenedLink').value); this.innerText='¡Copiado!';" 
                                class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-medium px-3 py-2 rounded-lg transition duration-200 whitespace-nowrap">
                            Copiar
                        </button>
                    </div>
                </div>
            <% } %>
        </div>

        <!-- Panel de Enlaces Recientes y Estadísticas -->
        <% if (typeof links !== 'undefined' && links.length > 0) { %>
            <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 md:p-6 backdrop-blur-sm">
                <h2 class="text-sm font-bold uppercase tracking-wider text-slate-300 mb-4 flex items-center justify-between">
                    <span>Enlaces Recientes & Clics</span>
                    <span class="text-xs text-purple-400 font-normal">Base de datos SQLite</span>
                </h2>
                <div class="space-y-3">
                    <% links.forEach(link => { %>
                        <div class="bg-slate-950/80 border border-slate-800/60 rounded-xl p-3.5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                            <div class="overflow-hidden">
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="text-xs font-bold text-purple-400">/<%= link.alias %></span>
                                    <span class="text-[10px] bg-slate-800 text-slate-400 px-2 py-0.5 rounded-full"><%= link.clicks %> clics</span>
                                </div>
                                <p class="text-xs text-slate-400 truncate max-w-xs sm:max-w-sm"><%= link.originalUrl %></p>
                            </div>
                            <a href="/<%= link.alias %>" target="_blank" 
                               class="bg-slate-800/80 hover:bg-purple-600 hover:text-white text-slate-300 text-xs font-medium px-3 py-1.5 rounded-lg transition duration-200 w-full sm:w-auto text-center">
                                Probar Enlace
                            </a>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% %>

    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-900 py-4 text-center text-slate-600 text-xs">
        LinkPulse B2B Suite &copy; 2026 - Todos los derechos reservados.
    </footer>

</body>
</html>
