<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>B2B Link Shortener & Retargeting</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between selection:bg-indigo-500 selection:text-white">
    
    <!-- HEADER -->
    <header class="border-b border-slate-800 bg-slate-900/50 backdrop-blur-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-9 h-9 rounded-xl bg-indigo-600 flex items-center justify-center font-bold text-lg shadow-lg shadow-indigo-600/30">
                    ⚡
                </div>
                <span class="font-bold text-lg tracking-tight">LinkPulse <span class="text-indigo-400 text-xs uppercase px-2 py-0.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 ml-1">B2B Suite</span></span>
            </div>
            <div class="flex items-center space-x-4">
                <span class="text-xs text-slate-400 bg-slate-800 px-3 py-1.5 rounded-lg border border-slate-700/50">Estado: <span class="text-emerald-400 font-medium">● Activo</span></span>
            </div>
        </div>
    </header>

    <!-- MAIN CONTENT -->
    <main class="max-w-4xl mx-auto px-6 py-12 flex-grow w-full">
        <div class="text-center mb-10">
            <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl mb-3">Acortador Inteligente & Retargeting</h1>
            <p class="text-slate-400 text-sm max-w-xl mx-auto">Crea enlaces corporativos de alto rendimiento, rastrea conversions y despliega pixeles de retargeting en tiempo real.</p>
        </div>

        <!-- CARD FORMULARIO -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-2xl relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500"></div>
            
            <form action="/shorten" method="POST" class="space-y-6">
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">URL de Destino (Original)</label>
                    <input type="url" name="originalUrl" required placeholder="https://tuempresa.com/landing-page" 
                        value="<%= originalUrl || '' %>"
                        class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-100 placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all">
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Alias Personalizado (Opcional)</label>
                    <div class="flex rounded-xl bg-slate-950 border border-slate-800 overflow-hidden focus-within:border-indigo-500 focus-within:ring-1 focus-within:ring-indigo-500 transition-all">
                        <span class="bg-slate-900 px-4 py-3 text-slate-500 text-sm border-r border-slate-800 flex items-center select-none">/</span>
                        <input type="text" name="customAlias" placeholder="oferta-verano" 
                            class="w-full bg-transparent px-4 py-3 text-sm text-slate-100 placeholder-slate-600 focus:outline-none">
                    </div>
                </div>

                <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-medium py-3.5 px-6 rounded-xl transition-all shadow-lg shadow-indigo-600/25 text-sm cursor-pointer active:scale-[0.99]">
                    Generar Enlace Acortado
                </button>
            </form>

            <% if (shortUrl) { %>
                <!-- RESULTADO -->
                <div class="mt-8 pt-6 border-t border-slate-800/80 animate-fade-in">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-emerald-400 mb-2">¡Enlace generado con éxito!</label>
                    <div class="flex items-center justify-between bg-slate-950 border border-emerald-500/30 rounded-xl p-3.5">
                        <a href="<%= shortUrl %>" target="_blank" class="text-indigo-400 hover:underline text-sm font-mono truncate mr-3"><%= shortUrl %></a>
                        <button onclick="navigator.clipboard.writeText('<%= shortUrl %>'); alert('¡Copiado al portapapeles!');" class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs px-3.5 py-2 rounded-lg font-medium transition-colors cursor-pointer shrink-0">
                            Copiar
                        </button>
                    </div>
                </div>
            <% } %>
        </div>
    </main>

    <!-- FOOTER -->
    <footer class="border-t border-slate-800/60 py-6 text-center text-xs text-slate-500">
        <p>Panel B2B de Retargeting &bull; Render Cloud Node.js</p>
    </footer>

</body>
</html>
